# Force LF everywhere. The differential harness compares byte offsets between two
# parsers, so a CRLF/LF split between platforms would desynchronize every offset past
# the first line. Golden test files (test/corpus/*.txt) are whitespace-sensitive too.
* text=auto eol=lf

# Generated parser artifacts: committed (consumers build from these directly) but not
# worth showing in diffs or counting toward language stats.
src/parser.c linguist-generated=true
src/math_unicode.h linguist-generated=true
src/grammar.json linguist-generated=true
src/node-types.json linguist-generated=true
src/tree_sitter/* linguist-vendored=true

*.png binary
*.gz binary
