{
  "name": "tree-sitter-typst",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Typst markup language",
  "license": "MIT",
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "queries/**",
    "src/**"
  ],
  "scripts": {
    "generate": "tree-sitter generate",
    "build": "tree-sitter generate && tree-sitter build",
    "test": "node test/run.mjs all",
    "test:corpus": "tree-sitter test",
    "test:valid": "node test/run.mjs valid",
    "test:diff": "node test/run.mjs diff",
    "test:fuzz": "node test/run.mjs fuzz",
    "test:incremental": "node test/run.mjs incremental",
    "coverage": "node test/run.mjs coverage",
    "test:queries": "node test/run.mjs queries",
    "oracle:build": "cargo build --release --manifest-path tools/oracle/Cargo.toml",
    "corpus:fetch": "node scripts/fetch-corpus.mjs",
    "parse": "tree-sitter parse"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.26.13"
  }
}
